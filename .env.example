# ─── PROVEDOR DE E-MAIL ─────────────────────────────────────────────
# brevo | resend | smtp
PROVEDOR=brevo

BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=senha-de-app-de-16-digitos

# ─── REMETENTE ──────────────────────────────────────────────────────
# Precisa ser um endereco VERIFICADO no provedor.
REMETENTE_NOME=Amigo Oracao 2026
REMETENTE_EMAIL=oracao@suaigreja.org.br
RESPONDER_PARA=maria@suaigreja.org.br

# ─── CONTEUDO DO E-MAIL ─────────────────────────────────────────────
EVENTO_NOME=Amigo Oracao - Novembro 2026
# Ate quando orar pelo amigo: o dia da revelacao (definido pela pastora).
DATA_REVELACAO=30 de novembro de 2026
# Opcional. Vazio ou ausente: o e-mail mostra so a data, sem "as ...".
# HORARIO_REVELACAO=19h30
ORGANIZADOR=Maria Souza (11) 90000-0000
VERSICULO=Mas tu, quando orares, entra no teu aposento e, fechando a tua porta, ora a teu Pai, que ve em secreto. (Mateus 6:6)

# ─── SORTEIO E ENVIO ────────────────────────────────────────────────
# ciclo = uma unica roda de oracao (sem pares reciprocos)  |  livre = desarranjo uniforme
MODO_SORTEIO=ciclo
INTERVALO_MS=700
MAX_TENTATIVAS_ENVIO=4
